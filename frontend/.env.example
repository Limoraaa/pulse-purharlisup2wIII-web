# Salin menjadi ".env.local" (laptop) atau ".env.production.local" (saat build untuk server).
# Alamat API backend Laravel, tanpa garis miring di akhir.
#   Laptop : http://localhost:8000/api
#   Server : https://<namadomain.com>/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Kosongkan bila aplikasi dipasang di root domain (disarankan).
NEXT_PUBLIC_BASE_PATH=
